{
  "name": "app",
  "private": true,
  "version": "2.1.2",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "node --test scripts/fetch-stockfish.test.mjs && vitest run",
    "test:watch": "vitest",
    "bench:rust": "cd src-tauri && cargo test --release --lib benchmark_analysis_overhead -- --ignored --nocapture",
    "bench:uci-ipc": "tauri dev -- -- --bench-uci-ipc",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "lint": "biome check src",
    "format": "biome format --write src"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "@tauri-apps/api": "^2.12.4",
    "chess.js": "^1.4.0",
    "chessground": "^9.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "effect": "4.0.6",
    "lucide-react": "^1.61.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "thinking-orbs": "^0.3.2",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "2.12.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "bun@1.4.4"
}
