{
  "productName": "EngineRoom",
  "identifier": "com.engineroom.rune",
  "description": "Local chess game review with Stockfish",
  "publisher": "EngineRoom",
  "licenseFile": "../LICENSE",
  "binaries": [
    {
      "path": "engineroom-rune",
      "main": true
    }
  ],
  "binariesDir": "target/release",
  "outDir": "target/packages",
  "externalBinaries": [
    "../app/src-tauri/binaries/stockfish"
  ],
  "resources": [
    "../LICENSE",
    "../THIRD_PARTY_NOTICES.md",
    "RUNE-LICENSE.txt",
    "assets/IBMPlex-LICENSE.txt",
    "assets/OCTICONS-LICENSE.txt"
  ],
  "formats": [
    "appimage"
  ],
  "icons": [
    "../app/src-tauri/icons/128x128.png"
  ],
  "appimage": {
    "excludedLibs": [
      "libwayland-client.so*",
      "libEGL*.so*",
      "libGLES*.so*",
      "libGL.so*",
      "libGLX*.so*",
      "libGLdispatch.so*",
      "libOpenGL.so*",
      "libgbm.so*",
      "libdrm*.so*",
      "libvulkan.so*",
      "libvulkan_*.so*"
    ]
  },
  "name": "engineroom-rune"
}
